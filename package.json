{
  "name": "ontology-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:init": "psql \"$DATABASE_URL\" -f packages/ontology-core/sql/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:automation": "node scripts/qa-automation.mjs",
    "qa:automation:ui": "node scripts/qa-automation-ui.mjs",
    "qa:automation:all": "npm run qa:automation && npm run qa:automation:ui"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "mysql2": "^3.23.3",
    "pg": "^8.12.0",
    "vue-echarts": "^7.0.3"
  }
}
